# Allowlist: only code and documentation are tracked. Exports, archives,
# databases, analysis output and local reports stay out of Git by default.
/*
!/.gitignore
!/README.md
!/LICENSE
!/READER_SERVICE.md
!/DATA_CONTRACT.md
!/MCP.md
!/ANALYSIS.md
!/analysis-config.example.json
!/docs/
/docs/*
!/docs/REBUILD.md
!/docs/ANALYTICS.md
!/docs/USAGE.md
!/pyproject.toml
!/requirements-mcp.lock
!/setup-mcp.ps1
!/start-api.cmd
!/import-file.cmd
!/process-analysis.cmd
!/process-analysis-all.cmd
!/qianji/
/qianji/*
!/qianji/*.py
!/tests/
/tests/*
!/tests/*.py
!/integrations/
/integrations/*
!/integrations/*.py
!/integrations/snapshot.schema.json
!/integrations/analytics.schema.json

# Explicit denies (also apply if the allowlist above is ever loosened)
data/
.local/
inbox/
exports/
archive/
backups/
reports/
*.csv
*.xls
*.xlsx
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.parquet
*.log
*.bak
.env
.env.*
*cookie*
*token*
*credential*
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
