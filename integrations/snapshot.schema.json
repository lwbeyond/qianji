{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "snapshot",
    "datasets"
  ],
  "properties": {
    "format": {
      "const": "qianji-normalized"
    },
    "format_version": {
      "const": 1
    },
    "snapshot": {
      "type": "object",
      "required": [
        "generation",
        "library_id",
        "revision",
        "updated_at",
        "contract_version",
        "ledgers",
        "available_datasets",
        "data_sha256",
        "counts"
      ],
      "properties": {
        "generation": {
          "type": "string"
        },
        "library_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "contract_version": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "processing": {
          "type": "object",
          "required": [
            "normalizer_version",
            "summary_version",
            "source_revision",
            "source_updated_at",
            "processed_at"
          ],
          "properties": {
            "normalizer_version": {
              "type": "string",
              "pattern": "[\\s\\S]*\\S[\\s\\S]*"
            },
            "summary_version": {
              "type": "string",
              "pattern": "[\\s\\S]*\\S[\\s\\S]*"
            },
            "source_revision": {
              "type": "integer",
              "minimum": 0
            },
            "source_updated_at": {
              "type": "string",
              "format": "date-time"
            },
            "processed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "ledgers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "utc_offset"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "utc_offset": {
                "type": "string",
                "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
              }
            },
            "additionalProperties": false
          }
        },
        "available_datasets": {
          "const": [
            "transactions",
            "daily_summary"
          ]
        },
        "data_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "counts": {
          "type": "object",
          "required": [
            "transactions",
            "daily_summary"
          ],
          "properties": {
            "transactions": {
              "type": "integer",
              "minimum": 0
            },
            "daily_summary": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "contract_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "processing"
        ]
      },
      "else": {
        "not": {
          "required": [
            "processing"
          ]
        }
      }
    },
    "datasets": {
      "type": "object",
      "required": [
        "transactions",
        "daily_summary"
      ],
      "properties": {
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "ledger_id",
              "source_key",
              "revision",
              "occurred_at",
              "date_local",
              "source_date",
              "utc_offset",
              "timezone_basis",
              "kind",
              "source_type",
              "amount",
              "currency",
              "category",
              "remark",
              "asset_id",
              "from_asset_id",
              "to_asset_id",
              "related_source_key",
              "related_record_id",
              "reimbursement_code",
              "source_file_sha256",
              "source_row"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^qj_[a-f0-9]{64}$"
              },
              "ledger_id": {
                "type": "string"
              },
              "source_key": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              },
              "date_local": {
                "type": "string",
                "format": "date"
              },
              "source_date": {
                "type": "string"
              },
              "utc_offset": {
                "type": "string",
                "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
              },
              "timezone_basis": {
                "const": "configured_fixed_offset"
              },
              "kind": {
                "enum": [
                  "expense",
                  "income",
                  "refund",
                  "transfer"
                ]
              },
              "source_type": {
                "enum": [
                  "支出",
                  "收入",
                  "退款",
                  "转账"
                ]
              },
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "category": {
                "type": "string"
              },
              "remark": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "asset_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "from_asset_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to_asset_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "related_source_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "related_record_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reimbursement_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source_file_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_row": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "daily_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ledger_id",
              "date_local",
              "currency",
              "count",
              "expense",
              "income",
              "refund",
              "transfer",
              "net_expense",
              "net_cashflow"
            ],
            "properties": {
              "ledger_id": {
                "type": "string"
              },
              "date_local": {
                "type": "string",
                "format": "date"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "expense": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "income": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "refund": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "transfer": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "net_expense": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "net_cashflow": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
